{
  "schemaVersion": 1,
  "id": "card-country-restriction",
  "kind": "training",
  "title": "限制银行卡国际交易，不能只填国家名单",
  "summary": "用户希望新虚拟卡每月限额为 2000 美元，并只允许在美国和加拿大使用。卡已激活，限额已设置，接下来配置国家限制。接口中的 `international_allowed=1` 允许全部国际交易，设为 `0` 才会执行允许国家名单。",
  "template": "training",
  "originalTask": {
    "question": [
      [
        {
          "role": "user",
          "content": "Activate a new virtual debit card linked to my checking account ending in '4456' with a monthly spending_limit of 2000.00 USD, set the card_status to 'active', and configure card_controls to lock international transactions outside 'US' and 'CA'."
        }
      ]
    ]
  },
  "presentation": {
    "branches": [
      {
        "title": "无指导",
        "summary": "写入了 US、CA 名单，却没有启用国家限制。",
        "tone": "before",
        "events": [
          {
            "type": "action",
            "name": "update_card_controls",
            "args": "card_id=5, international_allowed=1,\nallowed_countries=\"US,CA\"",
            "result": "international_allowed: true,\nallowed_countries: \"US,CA\"",
            "highlights": {
              "args": [
                {
                  "start": 11,
                  "end": 34,
                  "text": "international_allowed=1",
                  "tone": "before"
                }
              ],
              "result": [
                {
                  "start": 0,
                  "end": 27,
                  "text": "international_allowed: true",
                  "tone": "before"
                }
              ]
            },
            "source": {
              "file": "data/cases/training_case/reviewed-20261106/banking_6_2/before/trajectory.json",
              "message": 10,
              "returnMessage": 11
            }
          }
        ],
        "reasoning": {
          "title": "无指导 · 推理节选",
          "text": "If I set `international_allowed` to `1`, it allows all.\nIf I set `international_allowed` to `0`, it enforces the list.\n…\nI'll set `international_allowed` to `1` and `allowed_countries` to \"US,CA\".",
          "highlights": [
            {
              "start": 130,
              "end": 195,
              "text": "`international_allowed` to `1` and `allowed_countries` to \"US,CA\"",
              "tone": "before"
            }
          ],
          "source": {
            "file": "data/cases/training_case/reviewed-20261106/banking_6_2/before/trajectory.json",
            "message": 10
          }
        },
        "frameTitle": "工具调用与返回 · 节选"
      },
      {
        "title": "Teacher 指导后",
        "summary": "把国际交易开关设为 0，启用 US、CA 国家限制。",
