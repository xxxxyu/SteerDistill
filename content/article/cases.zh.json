    {
      "id": "method",
      "case": {
        "kind": "training",
        "id": "tool-list-numbering",
        "title": "知道要解锁，却调用了不存在的工具名",
        "task": "用户要求解锁全部车门并打开车灯。工具清单第 16、20 项分别是 lockDoors 和 setHeadlights，序号不属于名称。以下展示关键调用与返回字段。",
        "href": "cases/?group=training&case=tool-list-numbering",
        "layout": "branches",
        "branches": [
          {
            "title": "无指导",
            "tone": "before",
            "events": [
              {
                "type": "action",
                "name": "16_lockDoors",
                "args": "unlock=true, door=[\"driver\", \"passenger\", \"rear_left\", \"rear_right\"]",
                "result": "Unknown or unavailable advertised tool: 16_lockDoors",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 3,
                      "text": "16_",
                      "tone": "before"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/before/trajectory.json",
                  "message": 4,
                  "returnMessage": 5
                }
              },
              {
                "type": "action",
                "name": "20_setHeadlights",
                "args": "mode=\"on\"",
                "result": "Unknown or unavailable advertised tool: 20_setHeadlights",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 3,
                      "text": "20_",
                      "tone": "before"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/before/trajectory.json",
                  "message": 6,
                  "returnMessage": 7
                }
              }
            ]
          },
          {
            "title": "Teacher 指导后",
            "tone": "after",
            "events": [
              {
                "type": "action",
                "name": "lockDoors",
                "args": "unlock=true, door=[\"driver\", \"passenger\", \"rear_left\", \"rear_right\"]",
                "result": "lockStatus: \"unlocked\", remainingUnlockedDoors: 4",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 9,
                      "text": "lockDoors",
                      "tone": "after"
                    }
                  ],
                  "result": [
                    {
                      "start": 24,
                      "end": 49,
                      "text": "remainingUnlockedDoors: 4",
                      "tone": "after"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/after/attempt-0/trajectory.json",
                  "message": 4,
                  "returnMessage": 5
                }
              },
              {
                "type": "action",
                "name": "setHeadlights",
                "args": "mode=\"on\"",
                "result": "headlightStatus: \"on\"",
                "highlights": {
                  "name": [
                    {
                      "start": 0,
                      "end": 13,
                      "text": "setHeadlights",
                      "tone": "after"
                    }
                  ],
                  "result": [
                    {
                      "start": 17,
                      "end": 21,
                      "text": "\"on\"",
                      "tone": "after"
                    }
                  ]
                },
                "source": {
                  "file": "data/case-library/training/tool-list-numbering/raw/after/attempt-0/trajectory.json",
                  "message": 6,
                  "returnMessage": 7
                }
              }
            ]
          }
        ],
        "guidance": {
          "summary": "检查可用的解锁与开灯工具；使用 lockDoors 解锁全部车门，再用 setHeadlights 开灯。"
        },
        "checks": [
          {
            "label": "局部核验",
            "text": "四扇车门均已解锁，车灯尚未打开。环境状态与 Teacher 参考步骤一致，局部核验通过。"
          },
          {
            "label": "后续执行",
            "text": "撤去指导后，agent 调用 `setHeadlights(mode=\"on\")` 打开车灯。车门保持解锁，任务核验通过。"
          }
        ]
      }
    },
